local UI = {Tabs = {}, IsFirstTab = true}
function UI:CreateTab(name)
    local isDefault = UI.IsFirstTab
    UI.IsFirstTab = false

    local TabBtn = Instance.new("TextButton", Sidebar)
    TabBtn.Size = UDim2.new(0.9, 0, 0, 28)
    TabBtn.BackgroundColor3 = isDefault and CurrentTheme.HeaderBG or CurrentTheme.ContainerBG
    TabBtn.Text = isDefault and ("<b>> " .. name .. "</b>") or ("> " .. name)
    TabBtn.RichText = true
    TabBtn.TextColor3 = isDefault and CurrentTheme.Accent or CurrentTheme.SubText
    TabBtn.TextSize = 12
    Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 8)
    RegisterText(TabBtn)

    local TabScroll = Instance.new("ScrollingFrame", ContentHolder)
    TabScroll.Size = UDim2.new(1, 0, 1, 0)
    TabScroll.BackgroundTransparency = 1
    TabScroll.ScrollBarThickness = 3
    TabScroll.Visible = isDefault
    TabScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    TabScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    local Layout = Instance.new("UIListLayout", TabScroll)
    Layout.Padding = UDim.new(0, 8)

    TabBtn.MouseButton1Click:Connect(function()
        for _, tab in pairs(UI.Tabs) do
            tab.Scroll.Visible = false
            tab.Btn.BackgroundColor3 = CurrentTheme.ContainerBG
            tab.Btn.TextColor3 = CurrentTheme.SubText
            tab.Btn.Text = "> " .. tab.Name
        end
        TabScroll.Visible = true
        TabBtn.BackgroundColor3 = CurrentTheme.HeaderBG
        TabBtn.TextColor3 = CurrentTheme.Accent
        TabBtn.Text = "<b>> " .. name .. "</b>"
    end)
    table.insert(UI.Tabs, {Scroll = TabScroll, Btn = TabBtn, Name = name})

    local Elements = {}
    function Elements:AddButton(text, callback)
        local Btn = Instance.new("TextButton", TabScroll)
        Btn.Size = UDim2.new(0.98, 0, 0, 32)
        Btn.BackgroundColor3 = CurrentTheme.ContainerBG
        Btn.Text = "  [EXEC] " .. text
        Btn.TextColor3 = CurrentTheme.Text
        Btn.TextXAlignment = Enum.TextXAlignment.Left
        Btn.TextSize = 13
        Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 8)
        RegisterText(Btn)
        Btn.MouseButton1Click:Connect(function() pcall(callback) end)
    end
    function Elements:AddToggle(text, default, callback)
        local state = default or false
        local Toggle = Instance.new("TextButton", TabScroll)
        Toggle.Size = UDim2.new(0.98, 0, 0, 32)
        Toggle.BackgroundColor3 = CurrentTheme.ContainerBG
        Toggle.Text = "  [" .. (state and "X" or " ") .. "] " .. text
        Toggle.TextColor3 = state and CurrentTheme.Accent or CurrentTheme.Text
        Toggle.TextXAlignment = Enum.TextXAlignment.Left
        Toggle.TextSize = 13
        Instance.new("UICorner", Toggle).CornerRadius = UDim.new(0, 8)
        RegisterText(Toggle)
        Toggle.MouseButton1Click:Connect(function()
            state = not state
            Toggle.Text = "  [" .. (state and "X" or " ") .. "] " .. text
            Toggle.TextColor3 = state and CurrentTheme.Accent or CurrentTheme.Text
            pcall(callback, state)
        end)
    end
    function Elements:AddSlider(text, min, max, default, callback)
        local Frame = Instance.new("Frame", TabScroll)
        Frame.Size = UDim2.new(0.98, 0, 0, 46)
        Frame.BackgroundColor3 = CurrentTheme.ContainerBG
        Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 8)
        local Label = Instance.new("TextLabel", Frame)
        Label.Text = "  " .. text .. " :: " .. tostring(default)
        Label.Size = UDim2.new(1, 0, 0, 22)
        Label.BackgroundTransparency = 1
        Label.TextColor3 = CurrentTheme.Text
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.TextSize = 12
        RegisterText(Label)
        local Track = Instance.new("Frame", Frame)
        Track.Size = UDim2.new(0.92, 0, 0, 6)
        Track.Position = UDim2.new(0.04, 0, 0.65, 0)
        Track.BackgroundColor3 = CurrentTheme.MainBG
        Instance.new("UICorner", Track).CornerRadius = UDim.new(0, 4)
        local Fill = Instance.new("Frame", Track)
        Fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
        Fill.BackgroundColor3 = CurrentTheme.Accent
        Instance.new("UICorner", Fill).CornerRadius = UDim.new(0, 4)
        RegisterDynamic(Fill)
        local sliding = false
        Track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding = true end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
                local delta = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                local val = math.floor(min + (max - min) * delta)
                Fill.Size = UDim2.new(delta, 0, 1, 0)
                Label.Text = "  " .. text .. " :: " .. tostring(val)
                pcall(callback, val)
            end
        end)
    end
    function Elements:AddKeybind(text, defaultKey, callback)
        local Frame = Instance.new("Frame", TabScroll)
        Frame.Size = UDim2.new(0.98, 0, 0, 36)
        Frame.BackgroundColor3 = CurrentTheme.ContainerBG
        Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 8)
        local Label = Instance.new("TextLabel", Frame)
        Label.Text = "  " .. text
        Label.Size = UDim2.new(0.6, 0, 1, 0)
        Label.BackgroundTransparency = 1
        Label.TextColor3 = CurrentTheme.Text
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.TextSize = 12
        RegisterText(Label)
        local KeyBtn = Instance.new("TextButton", Frame)
        KeyBtn.Size = UDim2.new(0.35, 0, 0.7, 0)
        KeyBtn.Position = UDim2.new(0.62, 0, 0.15, 0)
        KeyBtn.BackgroundColor3 = CurrentTheme.HeaderBG
        KeyBtn.Text = defaultKey.Name
        KeyBtn.TextColor3 = CurrentTheme.Accent
        KeyBtn.TextSize = 11
        Instance.new("UICorner", KeyBtn).CornerRadius = UDim.new(0, 6)
        RegisterText(KeyBtn)
        local listening = false
        KeyBtn.MouseButton1Click:Connect(function()
            listening = true
            KeyBtn.Text = "PRESS KEY..."
        end)
        UserInputService.InputBegan:Connect(function(input, gpe)
            if listening and not gpe and input.UserInputType == Enum.UserInputType.Keyboard then
                listening = false
                KeyBtn.Text = input.KeyCode.Name
                pcall(callback, input.KeyCode)
            end
        end)
    end
    return Elements
end

