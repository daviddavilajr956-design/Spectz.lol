-- Dynamic Rainbow Renderer
RunService.RenderStepped:Connect(function(dt)
    if CONFIG.RAINBOW_ENABLED then
        currentHue = (currentHue + (CONFIG.RAINBOW_SPEED * dt)) % 1
        local rainbowColor = Color3.fromHSV(currentHue, 0.8, 1)
        for _, obj in ipairs(DynamicObjects) do
            if obj:IsA("UIStroke") then
                obj.Color = rainbowColor
            elseif obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                obj.TextColor3 = rainbowColor
            else
                obj.BackgroundColor3 = rainbowColor
            end
        end
    end
end)

local function RegisterDynamic(obj) table.insert(DynamicObjects, obj) end
local function RegisterText(obj)
    table.insert(TextObjects, obj)
    obj.Font = CONFIG.CURRENT_FONT
end

local function SetGlobalFont(font)
    CONFIG.CURRENT_FONT = font
    for _, obj in ipairs(TextObjects) do
        if obj and obj.Parent then obj.Font = font end
    end
end

-- Draggable Logic Utility
local function MakeDraggable(frame, handle)
    local dragging, dragInput, dragStart, startPos
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then dragInput = input end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

-- Persistent Settings
local function SaveSettings()
    if writefile then
        local data = {
            RainbowEnabled = CONFIG.RAINBOW_ENABLED,
            RainbowSpeed = CONFIG.RAINBOW_SPEED,
            ToggleKey = CONFIG.TOGGLE_KEY.Name,
            ClickTPKey = CONFIG.CLICK_TP_KEY.Name,
            FontName = tostring(CONFIG.CURRENT_FONT.Name)
        }
        pcall(function() writefile(CONFIG.SETTING_FILE, HttpService:JSONEncode(data)) end)
    end
end

local function LoadSettings()
    if readfile and isfile and isfile(CONFIG.SETTING_FILE) then
        pcall(function()
            local raw = readfile(CONFIG.SETTING_FILE)
            local data = HttpService:JSONDecode(raw)
            if data.RainbowEnabled ~= nil then CONFIG.RAINBOW_ENABLED = data.RainbowEnabled end
            if data.RainbowSpeed then CONFIG.RAINBOW_SPEED = data.RainbowSpeed end
            if data.ToggleKey and Enum.KeyCode[data.ToggleKey] then CONFIG.TOGGLE_KEY = Enum.KeyCode[data.ToggleKey] end
            if data.ClickTPKey and Enum.KeyCode[data.ClickTPKey] then CONFIG.CLICK_TP_KEY = Enum.KeyCode[data.ClickTPKey] end
            if data.FontName and Enum.Font[data.FontName] then SetGlobalFont(Enum.Font[data.FontName]) end
        end)
    end
end

