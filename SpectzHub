-- Helper function to generate full feature blocks with guaranteed click mechanics
local function createFeatureToggle(name, desc, order)
    local holder = Instance.new("Frame")
    holder.Name = name .. "Holder"
    holder.Size = UDim2.new(1, 0, 0, 55)
    holder.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
    holder.BorderColor3 = Color3.fromRGB(40, 40, 40)
    holder.LayoutOrder = order
    holder.Parent = Content

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -70, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = name .. "\n<font size='11' color='#888888'>" .. desc .. "</font>"
    label.TextColor3 = Color3.fromRGB(230, 230, 230)
    label.TextSize = 14
    label.Font = Enum.Font.Code
    label.RichText = true
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = holder

    -- Using TextButton with Active = true and MouseButton1Click override
    local toggle = Instance.new("TextButton")
    toggle.Name = "ToggleBtn"
    toggle.Size = UDim2.new(0, 45, 0, 25)
    toggle.Position = UDim2.new(1, -55, 0.5, -12)
    toggle.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    toggle.BorderColor3 = Color3.fromRGB(60, 60, 60)
    toggle.Text = "OFF"
    toggle.TextColor3 = Color3.fromRGB(180, 180, 180)
    toggle.TextSize = 12
    toggle.Font = Enum.Font.Code
    toggle.AutoButtonColor = true
    toggle.Active = true
    toggle.ZIndex = 5
    toggle.Parent = holder

    local active = false
    toggle.MouseButton1Click:Connect(function()
        active = not active
        if active then
            toggle.BackgroundColor3 = Color3.fromRGB(0, 120, 60)
            toggle.TextColor3 = Color3.fromRGB(255, 255, 255)
            toggle.Text = "ON"
        else
            toggle.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
            toggle.TextColor3 = Color3.fromRGB(180, 180, 180)
            toggle.Text = "OFF"
        end
    end)
end

